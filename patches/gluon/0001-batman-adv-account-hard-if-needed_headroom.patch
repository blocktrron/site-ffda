From 99caa860e9e9d8c9b5c2d9386105ce8ce34dec87 Mon Sep 17 00:00:00 2001
From: David Bauer <mail@david-bauer.net>
Date: Tue, 2 Dec 2025 03:01:27 +0100
Subject: [PATCH] batman-adv: account hard-if needed_headroom

---
 ...-adv-account-hard-if-needed_headroom.patch | 150 ++++++++++++++++++
 1 file changed, 150 insertions(+)
 create mode 100644 patches/packages/routing/0004-batman-adv-account-hard-if-needed_headroom.patch

diff --git a/patches/packages/routing/0004-batman-adv-account-hard-if-needed_headroom.patch b/patches/packages/routing/0004-batman-adv-account-hard-if-needed_headroom.patch
new file mode 100644
index 00000000..a8de3dd0
--- /dev/null
+++ b/patches/packages/routing/0004-batman-adv-account-hard-if-needed_headroom.patch
@@ -0,0 +1,150 @@
+From: David Bauer <mail@david-bauer.net>
+Date: Tue, 2 Dec 2025 03:01:06 +0100
+Subject: batman-adv: account hard-if needed_headroom
+
+diff --git a/batman-adv/patches/2003-batman-adv-account-hard-interface-overhead.patch b/batman-adv/patches/2003-batman-adv-account-hard-interface-overhead.patch
+new file mode 100644
+index 0000000000000000000000000000000000000000..4707f90fb6698f3bc7a1c62cce1e643f91344386
+--- /dev/null
++++ b/batman-adv/patches/2003-batman-adv-account-hard-interface-overhead.patch
+@@ -0,0 +1,140 @@
++From f8f0cf67cd1e23847077950a878712296b1440d1 Mon Sep 17 00:00:00 2001
++From: David Bauer <mail@david-bauer.net>
++Date: Wed, 26 Nov 2025 18:37:40 +0100
++Subject: [PATCH] batman-adv: account hard-interface overhead
++
++batman-adv pushes an additional ethernet header on transmit to a mesh
++hard-interface. However, it does not account eventual headroom needed by
++said hard-interface.
++
++Enlarge the skb head to the size required by the hard-interface before
++pushing the ethernet header. This avoids enlarging the header a second
++time when pushing headers required by the hard-interface.
++
++Signed-off-by: David Bauer <mail@david-bauer.net>
++---
++ net/batman-adv/hard-interface.h | 21 +++++++++++++++++++++
++ net/batman-adv/mesh-interface.c | 20 +++++++++++++++++---
++ net/batman-adv/mesh-interface.h |  2 ++
++ net/batman-adv/send.c           |  5 +++--
++ 4 files changed, 43 insertions(+), 5 deletions(-)
++
++diff --git a/net/batman-adv/hard-interface.h b/net/batman-adv/hard-interface.h
++index 9db8a310961ea..6f13a411fdd36 100644
++--- a/net/batman-adv/hard-interface.h
+++++ b/net/batman-adv/hard-interface.h
++@@ -118,4 +118,25 @@ batadv_primary_if_get_selected(struct batadv_priv *bat_priv)
++ 	return hard_iface;
++ }
++ 
+++/**
+++ * batadv_hardif_required_headroom() - calculate required headroom for a hard
+++ *  interface
+++ * @hard_iface: the hard interface to calculate headroom for
+++ *
+++ * Return: required headroom size, 0 if undeterminable
+++ */
+++static inline unsigned int
+++batadv_hardif_required_headroom(struct batadv_hard_iface *hard_iface)
+++{
+++	unsigned int headroom = 0;
+++
+++	if (hard_iface->net_dev) {
+++		headroom += hard_iface->net_dev->needed_headroom;
+++		if (hard_iface->net_dev->hard_header_len > ETH_HLEN)
+++			headroom += hard_iface->net_dev->hard_header_len - ETH_HLEN;
+++	}
+++
+++	return headroom;
+++}
+++
++ #endif /* _NET_BATMAN_ADV_HARD_INTERFACE_H_ */
++diff --git a/net/batman-adv/mesh-interface.c b/net/batman-adv/mesh-interface.c
++index df7e95811ef56..0a9b8c2fbdfc5 100644
++--- a/net/batman-adv/mesh-interface.c
+++++ b/net/batman-adv/mesh-interface.c
++@@ -51,13 +51,15 @@
++ #include "translation-table.h"
++ 
++ /**
++- * batadv_skb_head_push() - Increase header size and move (push) head pointer
+++ * batadv_skb_head_push_headroom() - Increase header size and move (push)
+++ *  head pointer preserving specified headroom
++  * @skb: packet buffer which should be modified
++  * @len: number of bytes to add
+++ * @headroom: size of headroom to allocate
++  *
++  * Return: 0 on success or negative error number in case of failure
++  */
++-int batadv_skb_head_push(struct sk_buff *skb, unsigned int len)
+++int batadv_skb_head_push_headroom(struct sk_buff *skb, unsigned int len, unsigned int headroom)
++ {
++ 	int result;
++ 
++@@ -68,7 +70,7 @@ int batadv_skb_head_push(struct sk_buff *skb, unsigned int len)
++ 	 * after that call and thus allow other skbs with the same data buffer
++ 	 * to write freely in that area.
++ 	 */
++-	result = skb_cow_head(skb, len);
+++	result = skb_cow_head(skb, len + headroom);
++ 	if (result < 0)
++ 		return result;
++ 
++@@ -76,6 +78,18 @@ int batadv_skb_head_push(struct sk_buff *skb, unsigned int len)
++ 	return 0;
++ }
++ 
+++/**
+++ * batadv_skb_head_push() - Increase header size and move (push) head pointer
+++ * @skb: packet buffer which should be modified
+++ * @len: number of bytes to add
+++ *
+++ * Return: 0 on success or negative error number in case of failure
+++ */
+++int batadv_skb_head_push(struct sk_buff *skb, unsigned int len)
+++{
+++	return batadv_skb_head_push_headroom(skb, len, 0);
+++}
+++
++ /**
++  * batadv_sum_counter() - Sum the cpu-local counters for index 'idx'
++  * @bat_priv: the bat priv with all the mesh interface information
++diff --git a/net/batman-adv/mesh-interface.h b/net/batman-adv/mesh-interface.h
++index 53756c5a45e04..c95d4f37d54e1 100644
++--- a/net/batman-adv/mesh-interface.h
+++++ b/net/batman-adv/mesh-interface.h
++@@ -15,6 +15,8 @@
++ #include <linux/types.h>
++ 
++ int batadv_skb_head_push(struct sk_buff *skb, unsigned int len);
+++int batadv_skb_head_push_headroom(struct sk_buff *skb, unsigned int len,
+++				  unsigned int headroom);
++ void batadv_interface_rx(struct net_device *mesh_iface,
++ 			 struct sk_buff *skb, int hdr_size,
++ 			 struct batadv_orig_node *orig_node);
++diff --git a/net/batman-adv/send.c b/net/batman-adv/send.c
++index 20d85c681064a..ec7e2cb8bdbc0 100644
++--- a/net/batman-adv/send.c
+++++ b/net/batman-adv/send.c
++@@ -63,7 +63,7 @@ int batadv_send_skb_packet(struct sk_buff *skb,
++ 			   const u8 *dst_addr)
++ {
++ 	struct ethhdr *ethhdr;
++-	int ret;
+++	int ret, headroom;
++ 
++ 	if (hard_iface->if_status != BATADV_IF_ACTIVE)
++ 		goto send_skb_err;
++@@ -78,7 +78,8 @@ int batadv_send_skb_packet(struct sk_buff *skb,
++ 	}
++ 
++ 	/* push to the ethernet header. */
++-	if (batadv_skb_head_push(skb, ETH_HLEN) < 0)
+++	headroom = batadv_hardif_required_headroom(hard_iface);
+++	if (batadv_skb_head_push_headroom(skb, ETH_HLEN, headroom) < 0)
++ 		goto send_skb_err;
++ 
++ 	skb_reset_mac_header(skb);
++-- 
++2.51.0
++
-- 
2.51.0

